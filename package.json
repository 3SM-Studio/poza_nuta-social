{
  "name": "pozanuta-social",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run guard && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "guard": "node scripts/ui-guard.mjs && node scripts/design-guard.mjs && node scripts/privacy-guard.mjs && node scripts/secret-guard.mjs",
    "secret:scan": "node scripts/secret-guard.mjs",
    "impeccable:install": "impeccable install -y --providers=codex --scope=project",
    "impeccable:update": "impeccable update",
    "impeccable:detect": "impeccable detect src/",
    "verify": "npm run guard && npm run impeccable:detect && npm run lint && npm run typecheck && npm test && next build",
    "test:e2e": "playwright test",
    "test:e2e:local": "node scripts/run-local-e2e.mjs",
    "test:db": "supabase test db",
    "test:admin:concurrency": "node scripts/admin-platform-concurrency.mjs",
    "test:analytics:concurrency": "node scripts/analytics-concurrency.mjs",
    "test:scenario-matrix": "node scripts/scenario-matrix-check.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.3.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "impeccable": "4.1.0",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
