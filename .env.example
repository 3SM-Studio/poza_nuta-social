NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only if the project still exposes an anon key instead of a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred server-only key. Never expose it through a NEXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=
# Temporary legacy fallback for local/older projects that have not issued a secret key yet.
SUPABASE_SERVICE_ROLE_KEY=
ANALYTICS_SIGNING_SECRET=
# Optional one-time bootstrap only. Grants nothing after an active owner exists.
BOOTSTRAP_OWNER_EMAIL=
CONTACT_EMAIL=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Instagram is the approved primary destination and defaults to https://www.instagram.com/poza.nuta/.
# Other public destinations render only when configured. Set Instagram here only to override its default.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_MAIN_SITE_URL=
