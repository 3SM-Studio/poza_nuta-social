# Canonical origin only (no path or trailing slash). Future production value: https://pozanuta.pl. Previews must not choose a different canonical domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback only if the project still exposes an anon key instead of a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred server-only key. Never expose it through a NEXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=
# Temporary legacy fallback for local/older projects that have not issued a secret key yet.
SUPABASE_SERVICE_ROLE_KEY=
ANALYTICS_SIGNING_SECRET=
# Optional one-time bootstrap only. Grants nothing after an active owner exists.
BOOTSTRAP_OWNER_EMAIL=
# Public B2B contact. An unset or invalid value also falls back to this owner-approved address.
CONTACT_EMAIL=hello@pozanuta.pl
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTROLLER_ADDRESS=
PRIVACY_CONTACT_EMAIL=
# Public-facing recipient categories, transfer details (or explicit lack), and approved server-side retention periods.
PRIVACY_RECIPIENTS=
PRIVACY_TRANSFERS=
PRIVACY_RETENTION=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Instagram is the approved primary destination and defaults to https://www.instagram.com/poza.nuta/.
# Other public destinations render only when configured. Set Instagram here only to override its default.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_MAIN_SITE_URL=
